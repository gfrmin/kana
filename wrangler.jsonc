{
  // Cloudflare Workers config. Deploy with `npx wrangler deploy`, or just push
  // to master — .github/workflows/deploy.yml calls the shared recipe in
  // gfrmin/site-kit.
  //
  // Migrated from Cloudflare Pages 2026-09-05. Pages stays supported and gets
  // bug fixes, but every new platform feature ships to Workers only. The old
  // Pages project `kana` is deliberately left in place as the rollback:
  // re-attaching kana.gfrm.in to it is a one-call revert.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kana",
  "compatibility_date": "2026-09-05",

  "assets": {
    "directory": "./dist",

    // This site is one page with no client-side router, so an unmatched path
    // is a real 404 and should say so. Under the Pages default (and under
    // "single-page-application", which the cutover used to preserve it exactly)
    // every typo returned 200 with the chart, which lets a crawler index the
    // same page under unlimited URLs.
    //
    // Requires public/404.html to exist — without it this setting has nothing
    // to serve.
    "not_found_handling": "404-page",
  },

  "observability": {
    "enabled": true,
  },
}
